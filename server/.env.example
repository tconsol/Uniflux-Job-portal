PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/uniflux_job_portal

# JWT run `node scripts/generate-env.js` to auto-generate
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMTP (use Gmail App Password or any SMTP provider)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tconsolutions.com
SMTP_PASS=Info@tconsol4u
EMAIL_FROM=Tcon Solutions <info@tconsolutions.com>

# Eureka Service Discovery
EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_APP_NAME=UNIFLUX-JOB-PORTAL
EUREKA_INSTANCE_HOST=localhost
EUREKA_INSTANCE_PORT=5000
JOB_SERVICE_NAME=UNIFLUX-JOB-SERVICE

# CORS
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
