PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/uniflux_job_portal

# JWT run `node scripts/generate-env.js` to auto-generate
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=Uniflux <info@example.com>

# Marketplace Service (Python FastAPI scraper gateway)
MARKETPLACE_API_URL=https://uniflux-apigateway-64307221061.asia-south1.run.app
MARKETPLACE_JWT_SECRET=uniflux-super-secret-key-must-be-32-chars-min
MARKETPLACE_ORG_ID=uniflux-portal

# CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
